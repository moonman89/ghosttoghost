rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds;
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
    }

    // Path: chatUploads/{chatId}/{uid}/{timestamp}_{filename}
    // chatId → membership check; uid segment → upload ownership.
    match /chatUploads/{chatId}/{uid}/{fileName} {
      allow read: if signedIn() && isChatMember(chatId);

      allow create: if signedIn()
        && uid == request.auth.uid
        && isChatMember(chatId)
        && isAllowedImage();

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
