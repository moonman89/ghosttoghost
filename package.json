{
  "name": "ghosttoghost",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "bash scripts/generate-messaging-sw.sh && next dev",
    "build": "bash scripts/generate-messaging-sw.sh && next build",
    "build:frontend": "bash scripts/generate-messaging-sw.sh && next build",
    "build:functions": "npm --prefix functions run build",
    "start": "next start",
    "lint": "eslint",
    "setup:firebase": "bash scripts/setup-firebase.sh",
    "deploy:rules": "bash scripts/deploy-rules.sh",
    "deploy:functions": "bash scripts/deploy-functions.sh",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "deploy:all": "bash scripts/deploy-all.sh",
    "fix:production": "bash scripts/fix-production-auth.sh"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "next": "15.5.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
